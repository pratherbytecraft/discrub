{
  "name": "discrub",
  "version": "2.1.5",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json && vite build",
    "build:hosted": "tsc --project tsconfig.build.json && VITE_HOSTED_GATE=true vite build",
    "build:classic": "node scripts/build-classic.mjs",
    "build:classic:chrome": "node scripts/build-classic.mjs chrome",
    "build:classic:firefox": "node scripts/build-classic.mjs firefox",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:extension": "vitest run scripts/build-extension.test.js",
    "build:extension:chrome": "vite build --config vite.config.extension.ts --mode chrome && node scripts/build-extension.js chrome",
    "build:extension:firefox": "vite build --config vite.config.extension.ts --mode firefox && node scripts/build-extension.js firefox",
    "build:extension": "npm run build:extension:chrome && npm run build:extension:firefox",
    "package:chrome": "node scripts/package-extension.js chrome",
    "package:firefox": "node scripts/package-extension.js firefox",
    "package:extension": "npm run package:chrome && npm run package:firefox",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:firefox": "cypress run --browser /Applications/Firefox.app/Contents/MacOS/firefox",
    "cy:run:cross-browser": "npm run cy:run:chrome && npm run cy:run:firefox",
    "demo:screenshots": "cypress run --spec cypress/e2e/demo/feature-showcase.cy.ts && node scripts/copy-demo-screenshots.js",
    "visual-audit": "cypress run --spec cypress/e2e/visual-audit.cy.ts && node scripts/visual-audit-report.js",
    "prepare-release": "npm run demo:screenshots && npm run build:extension && npm run package:extension && node scripts/build-source-bundle.js && node scripts/prepare-store-release.js",
    "version:set": "node scripts/set-version.js"
  },
  "dependencies": {
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@mui/system": "^7.3.6",
    "@mui/x-date-pickers": "^7.22.2",
    "@pratherbytecraft/contributions": "^1.0.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@tanstack/react-virtual": "^3.13.13",
    "@transcend-io/conflux": "^6.1.3",
    "copy-to-clipboard": "^3.3.3",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^3.2.0",
    "discrub-core": "^1.0.11",
    "drip-fs": "^1.1.0",
    "emojibase": "^17.0.0",
    "emojibase-data": "^17.0.0",
    "fflate": "^0.8.2",
    "file-saver": "^2.0.5",
    "filenamify": "^6.0.0",
    "i18next": "^26.4.2",
    "idb-keyval": "^6.2.2",
    "nanoid": "^5.0.9",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.13",
    "react-joyride": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.1.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.17",
    "@storybook/addon-interactions": "8.6.17",
    "@storybook/addon-onboarding": "8.6.17",
    "@storybook/blocks": "8.6.17",
    "@storybook/react": "8.6.17",
    "@storybook/react-vite": "8.6.17",
    "@storybook/test": "8.6.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/archiver": "^7.0.0",
    "@types/chrome": "^0.1.37",
    "@types/file-saver": "^2.0.7",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "archiver": "^7.0.1",
    "cypress": "^14.5.4",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^23.0.0",
    "msw": "^2.12.10",
    "storybook": "8.6.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}
